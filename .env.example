POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379/0
ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_SIGNING_SECRET=
SECURE_COOKIES=false
SESSION_COOKIE_SAMESITE=lax
TEST_DATABASE_URL=
RUNTIME_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_ATTEMPTS=2
AGENT_TIMEOUT_SECONDS=25
AGENT_TOKEN_LIMIT=3000
KNOTDEVT_DEMO_PASSWORD=
# Optional research preview remains disabled until live-search spending is authorized.
PUBLIC_RESEARCH_ENABLED=false
# API, worker and Beat must share this queue; isolated runs use a unique value.
JOB_QUEUE=celery

# Optional free-only OpenRouter provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Groq's OpenAI-compatible endpoint. Keep live_ai_authorized=false until
# credentials and an explicit bounded test budget are approved.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=1
GROQ_MAX_RETRIES=1

# Project tool connectors (server only; never use NEXT_PUBLIC_ for secrets)
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_CALLBACK_BASE=http://localhost:8080/api/v1/integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Optional dedicated queue for new manual imports; local_runtime sets this.
IMPORT_JOB_QUEUE=knotdevt-imports
